{
    "C_Cpp.default.compilerPath": "/usr/bin/clang++",
    "C_Cpp.files.exclude": {
    },
    "makefile.configureOnOpen": false,
    "cmake.sourceDirectory": "/workspaces/ns3-roce/simulation",
    "cmake.configureArgs": [
        "-DCMAKE_CXX_STANDARD=20",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DNS3_ASSERT=ON",
        "-DNS3_LOG=ON",
        "-DNS3_NATIVE_OPTIMIZATIONS=OFF",
        "-DNS3_WARNINGS_AS_ERRORS=OFF",
        // Define `NS3_OUTPUT_DIRECTORY` so that it does not interfer with CMake from the console,
        // and permit to have Debug mode (vscode) and release mode.
        "-DNS3_OUTPUT_DIRECTORY=${workspaceFolder}/cmake-build-vscode/ns3-build"
    ],
    "cmake.buildDirectory": "${workspaceFolder}/cmake-build-vscode",
    "cmake.debugConfig": {
        "cwd": "${workspaceFolder}",
        "args": ["rdma-config/default-config.json"]
    },
    "files.associations": {
